.env
.env.local
.env.*.local
*.env
!.env.example

# ============================================
# Node.js / React / Frontend
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.yarn
.pnp.*
dist/
dist-ssr/
build/
.vite/
.cache/
.parcel-cache/

# ============================================
